+use glam::{Affine3A, EulerRot, Mat3A, Vec3A};
+
+/// Anchor-relative pose of every screen overlay, in the units the GUI
+/// speaks: degrees around/above the user, metres away.
+///
+/// `saved_transform` (not `transform`) is the authoritative value for
+/// `Anchored` overlays — `auto_movement` recomputes `transform` from it
+/// as `anchor * saved` every frame, so anything written to `transform`
+/// alone is discarded on the next tick.
+fn snapshot_layout<O>(overlays: &OverlayWindowManager<O>) -> Vec<packet_server::WlxScreenInfo>
+where
+    O: Default,
+{
+    overlays
+        .values()
+        .filter(|o| matches!(o.config.category, OverlayCategory::Screen))
+        .map(|o| {
+            let state = o.config.active_state.as_ref();
+            let transform = state
+                .and_then(|s| s.saved_transform)
+                .unwrap_or(o.config.default_state.transform);
+            let pos = transform.translation;
+            let distance = pos.length();
+            let pitch = if distance > 1e-4 {
+                (pos.y / distance).asin().to_degrees()
+            } else {
+                0.0
+            };
+
+            packet_server::WlxScreenInfo {
+                name: o.config.name.to_string(),
+                yaw: pos.x.atan2(-pos.z).to_degrees(),
+                pitch,
+                distance,
+                scale: scalar_scale(&transform),
+                curvature: state.and_then(|s| s.curvature).unwrap_or(0.0),
+                visible: state.is_some(),
+            }
+        })
+        .collect()
+}
+
+/// Build the anchor-relative transform for a screen sitting `distance`
+/// metres away at `yaw`/`pitch` degrees, turned to face the user.
+///
+/// Overlay planes face +Z, so the rotation that points a screen at the
+/// origin from (sin y cos p, sin p, -cos y cos p) is YXZ euler
+/// (-yaw, pitch, 0).
+fn place_transform(yaw_deg: f32, pitch_deg: f32, distance: f32, scale: f32) -> Affine3A {
+    let (yaw, pitch) = (yaw_deg.to_radians(), pitch_deg.to_radians());
+    let translation = Vec3A::new(
+        distance * yaw.sin() * pitch.cos(),
+        distance * pitch.sin(),
+        -distance * yaw.cos() * pitch.cos(),
+    );
+
+    Affine3A {
+        matrix3: Mat3A::from_euler(EulerRot::YXZ, -yaw, pitch, 0.0).mul_scalar(scale),
+        translation,
+    }
+}
 
