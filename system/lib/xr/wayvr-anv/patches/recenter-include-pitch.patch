 use libmonado::{MndResult, Monado, Pose, ReferenceSpaceType};
 use wgui::log::LogErr;
 
@@ -58,7 +58,8 @@
                 self.reset_offset(&mut monado.ipc);
             }
             PlayspaceTask::Recenter => {
