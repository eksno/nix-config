@@ -227,7 +228,7 @@
         }
     }
 
-    pub fn recenter(&mut self, input: &InputState, monado: &mut Monado) {
+    pub fn recenter(&mut self, input: &InputState, include_pitch: bool, monado: &mut Monado) {
         if self.drag.is_some() {
             log::info!("Space drag interrupted by recenter");
             self.drag = None;
@@ -256,7 +257,14 @@
 
         let hmd_yaw = if horiz_len_sq > f32::EPSILON {
             let yaw = (-fwd.x).atan2(-fwd.z);
-            Quat::from_rotation_y(yaw)
+            if include_pitch {
+                // fwd = R * -Z, so fwd.y = sin(pitch); YXZ keeps roll
+                // out so the horizon only tilts, never banks.
+                let pitch = fwd.y.clamp(-1.0, 1.0).asin();
+                Quat::from_euler(EulerRot::YXZ, yaw, pitch, 0.0)
+            } else {
+                Quat::from_rotation_y(yaw)
+            }
         } else {
             Quat::IDENTITY
         };
