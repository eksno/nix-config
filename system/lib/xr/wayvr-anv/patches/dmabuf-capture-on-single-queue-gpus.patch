+// Runs on the CAPTURE thread. Decides what can be finished here and what
+// has to wait for the main thread's transfer queue.
+//
+// The SHM branch must mmap here, where the fd is still open: the
+// wlr_screencopy capture thread closes it (BufData::drop) right after
+// this callback returns. Without that, MainThreadWlxCapture::receive()
+// mmap'd an already-closed fd, got MAP_FAILED (unchecked, -1) and
+// SIGSEGV'd in memcpy — the "wayvr capture crash on Mesa anv"
+// (single-queue GPUs only, since only those use MainThreadWlxCapture).
+fn receive_callback_split(me: &WlxCaptureIn, frame: WlxFrame) -> Option<MainThreadFrame> {
+    match frame {
+        // No queue submission — just an Arc clone of a pre-allocated image.
+        frame @ WlxFrame::Implicit(_) => receive_callback(me, frame).map(MainThreadFrame::Ready),
+        frame => map_memfd(frame).map(MainThreadFrame::Deferred),
+    }
 }
 
