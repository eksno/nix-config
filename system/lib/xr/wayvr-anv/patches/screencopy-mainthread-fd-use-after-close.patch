+// Runs on the CAPTURE thread, where the SHM fd is still open. The
+// wlr_screencopy capture thread closes the fd (BufData::drop) right after
+// this callback returns, so the main thread must never touch the fd —
+// mmap here and forward the mapping instead (it survives close(fd)).
+// Without this, MainThreadWlxCapture::receive() mmap'd an already-closed
+// fd, got MAP_FAILED (unchecked, -1) and SIGSEGV'd in memcpy — the
+// "wayvr capture crash on Mesa anv" (single-queue GPUs only, since only
+// those use MainThreadWlxCapture).
+#[allow(clippy::trivially_copy_pass_by_ref)]
+fn receive_callback_map_memfd(_: &DummyDrmExporter, frame: WlxFrame) -> Option<WlxFrame> {
+    match frame {
+        WlxFrame::MemFd(frame) => {
+            let Some(fd) = frame.plane.fd else {
+                log::error!("MemFd frame without fd");
+                return None;
+            };
+            let len = frame.plane.stride as usize * frame.format.height as usize;
+            let map = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    len,
+                    libc::PROT_READ,
+                    libc::MAP_SHARED,
+                    fd,
+                    i64::from(frame.plane.offset),
+                )
+            };
+            if map == libc::MAP_FAILED {
+                log::error!(
+                    "mmap of MemFd frame failed: {}",
+                    std::io::Error::last_os_error()
+                );
+                return None;
+            }
+            Some(WlxFrame::MemPtr(wlx_frame::MemPtrFrame {
+                format: frame.format,
+                ptr: map as usize,
+                size: len,
+                mouse: frame.mouse,
+            }))
+        }
+        other => Some(other),
+    }
+}
